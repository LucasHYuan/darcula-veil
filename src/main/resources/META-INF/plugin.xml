<idea-plugin>
    <id>com.lucashyuan.darculaveil</id>
    <name>Darcula Veil</name>
    <vendor email="lucas.h.yuan@gmail.com" url="https://github.com/LucasHYuan/darcula-veil">LucasHYuan</vendor>

    <description><![CDATA[
        Embeds external web content in a JetBrains IDE tool window and re-themes it to match the
        current IDE color scheme. Phase 1 ships a JCEF-backed tool window with a runtime-toggleable
        CSS filter layer. See the project README for the full architecture and roadmap.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Darcula Veil"
                    anchor="right"
                    factoryClass="com.lucashyuan.darculaveil.VeilToolWindowFactory"/>

        <toolWindow id="Darcula Veil Window"
                    anchor="right"
                    factoryClass="com.lucashyuan.darculaveil.nativewindow.VeilNativeToolWindowFactory"/>

        <applicationConfigurable parentId="tools"
                                 id="com.lucashyuan.darculaveil.settings"
                                 displayName="Darcula Veil"
                                 instance="com.lucashyuan.darculaveil.VeilConfigurable"/>
    </extensions>

    <actions>
        <action id="DarculaVeil.Toggle"
                class="com.lucashyuan.darculaveil.action.ToggleVeilAction"
                text="Toggle Darcula Veil"
                description="Enable or disable the theme filter on the embedded page">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift V"/>
        </action>

        <action id="DarculaVeil.BossKey"
                class="com.lucashyuan.darculaveil.action.BossKeyAction"
                text="Darcula Veil: Hide and Pause"
                description="Hide the Darcula Veil tool window and pause any playing media; press again to restore">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="DarculaVeil.PageForward"
                class="com.lucashyuan.darculaveil.action.PageForwardAction"
                text="Darcula Veil: Next Page"
                description="Turn the embedded page forward"/>

        <action id="DarculaVeil.PageBackward"
                class="com.lucashyuan.darculaveil.action.PageBackwardAction"
                text="Darcula Veil: Previous Page"
                description="Turn the embedded page backward"/>
    </actions>
</idea-plugin>
